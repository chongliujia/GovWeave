{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovWeave product registry and live advisory assessment",
  "description": "Private products.json stores administrative profile facts. Runtime and testing facts are reserved for server adapters. Live gateway and controlled-read-tool assessments are memory-only; explicit report snapshots and active testing use separate private stores.",
  "$ref": "#/$defs/Registry",
  "$defs": {
    "Registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "products"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "products": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Product"
          }
        }
      }
    },
    "ProductInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "name",
        "version",
        "application_ids",
        "pack_id",
        "pack_version",
        "facts"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "application_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          }
        },
        "pack_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "pack_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "facts": {
          "type": "object",
          "maxProperties": 112,
          "propertyNames": {
            "allOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
              },
              {
                "not": {
                  "pattern": "^(runtime|testing)\\."
                }
              }
            ]
          },
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "compliance.schema.json#/$defs/Fact"
              },
              {
                "properties": {
                  "source": {
                    "enum": [
                      "declared",
                      "document",
                      "assessment"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "Product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "name",
        "version",
        "application_ids",
        "pack_id",
        "pack_version",
        "facts",
        "schema_version",
        "id",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "application_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          }
        },
        "pack_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "pack_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "facts": {
          "type": "object",
          "maxProperties": 112,
          "propertyNames": {
            "allOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
              },
              {
                "not": {
                  "pattern": "^(runtime|testing)\\."
                }
              }
            ]
          },
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "compliance.schema.json#/$defs/Fact"
              },
              {
                "properties": {
                  "source": {
                    "enum": [
                      "declared",
                      "document",
                      "assessment"
                    ]
                  }
                }
              }
            ]
          }
        },
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SourceStamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_revision",
        "gateway_revision",
        "policy_revision",
        "audit_bytes",
        "audit_available"
      ],
      "properties": {
        "product_revision": {
          "type": "integer",
          "minimum": 1
        },
        "gateway_revision": {
          "type": "integer",
          "minimum": 0
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 0
        },
        "tool_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Global tool-store revision used for runtime.tools facts and cache freshness. Omitted for revision zero and optional for compatibility with reports archived before tool evidence was added. An omitted stamp does not establish current tool coverage."
        },
        "audit_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "audit_available": {
          "type": "boolean"
        },
        "output_policy_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Sensitive-output policy revision captured with these inputs. Omitted for revision zero or older retained reports; absence does not establish protection."
        },
        "test_evidence_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Process-local active-test evidence generation used to invalidate cached product assessments. Omitted at zero; not comparable across restarts."
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product_id",
        "product_revision",
        "state",
        "sample_limit"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "product_revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "pending",
            "ready",
            "error"
          ]
        },
        "error_code": {
          "enum": [
            "rule_pack_not_found",
            "compliance_busy",
            "evaluation_failed"
          ]
        },
        "next_refresh_at": {
          "type": "string",
          "format": "date-time"
        },
        "sample_limit": {
          "const": 100
        },
        "snapshot": {
          "$ref": "#/$defs/SourceStamp"
        },
        "evaluation": {
          "$ref": "compliance.schema.json#/$defs/Evaluation"
        },
        "runtime_evidence": {
          "$ref": "evidence.schema.json#/$defs/RuntimeEvidence",
          "description": "Optional exact metadata evidence for numeric runtime facts. Available even when content capture is disabled; retained with newly archived reports when audit is available. Older reports remain compatible."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready"
              }
            }
          },
          "then": {
            "required": [
              "snapshot",
              "evaluation",
              "next_refresh_at"
            ]
          },
          "else": {
            "not": {
              "required": [
                "evaluation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error_code",
              "snapshot"
            ]
          }
        }
      ]
    },
    "ProductList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products"
      ],
      "properties": {
        "products": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Product"
          }
        }
      }
    }
  }
}
