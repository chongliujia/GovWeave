{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovWeave controlled read-tool API",
  "description": "Application-scoped resource authorization and bounded credential-like output checks. These technical decisions are not legal conclusions or general semantic risk scores.",
  "$ref": "#/$defs/ToolSnapshot",
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "sensitivity",
        "allowed_applications"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "allowed_applications": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "description": "Explicit existing application IDs. Empty denies all applications, including for a public resource. Sensitivity alone never grants access.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instruction_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstructionReview"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ResourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "sensitivity"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "allowed_applications": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "uniqueItems": true,
          "description": "Explicit existing active application IDs. Omitted, null or empty denies all applications; saved metadata normalizes this to an array.",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "instruction_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstructionReview"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ToolInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "alias",
        "endpoint",
        "timeout_seconds",
        "output_mode",
        "resources"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Current global tool-store revision, not an individual tool revision. Zero or omitted on an initially empty store."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "alias": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "Complete operator-controlled HTTP(S) URL; no userinfo, query, fragment or dynamic path substitution."
        },
        "api_key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096,
          "writeOnly": true,
          "description": "Omit or null to retain an existing credential; empty string clears it. Non-empty credentials contain only printable non-whitespace ASCII."
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "allow_insecure_http": {
          "type": "boolean",
          "default": false
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "output_mode": {
          "enum": [
            "block",
            "observe"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ResourceInput"
          }
        },
        "instruction_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstructionPolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "name",
        "alias",
        "endpoint",
        "enabled",
        "allow_insecure_http",
        "timeout_seconds",
        "output_mode",
        "resources",
        "has_credential",
        "created_at",
        "snapshot_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "alias": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "enabled": {
          "type": "boolean"
        },
        "allow_insecure_http": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "output_mode": {
          "enum": [
            "block",
            "observe"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "has_credential": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of immutable public metadata with this field empty; not a signature or proof against local tampering."
        },
        "instruction_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstructionPolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ToolSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "tools"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "tools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Tool"
          }
        }
      }
    },
    "ToolHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "revisions"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/Tool"
          }
        }
      }
    },
    "InvokeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ContentFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "rule_ids"
      ],
      "properties": {
        "state": {
          "enum": [
            "observed",
            "not_observed",
            "unknown"
          ]
        },
        "rule_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "private_key",
              "api_key"
            ]
          }
        }
      }
    },
    "Governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "ruleset_version",
        "tool_revision",
        "action",
        "authorization",
        "data_sensitivity",
        "content",
        "decision",
        "reasons"
      ],
      "properties": {
        "policy_version": {
          "const": "read-tool-governance-v1"
        },
        "ruleset_version": {
          "const": "credentials-v1"
        },
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_revision": {
          "$ref": "#/$defs/Revision"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "const": "read"
        },
        "authorization": {
          "enum": [
            "unknown",
            "allowed",
            "denied"
          ]
        },
        "data_sensitivity": {
          "enum": [
            "unknown",
            "public",
            "internal",
            "restricted"
          ]
        },
        "output_mode": {
          "enum": [
            "block",
            "observe"
          ]
        },
        "content": {
          "$ref": "#/$defs/ContentFinding"
        },
        "decision": {
          "enum": [
            "pending",
            "allow",
            "observe",
            "block",
            "redact"
          ],
          "description": "pending occurs only in started audit events. Terminal decisions are allow, observe, block or redact."
        },
        "reasons": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resource_grant_allowed",
              "output_check_pending",
              "credential_patterns_not_observed",
              "credential_patterns_observed",
              "invalid_api_key",
              "unsupported_media_type",
              "request_too_large",
              "invalid_tool_request",
              "tool_not_allowed",
              "credential_unavailable",
              "gateway_busy",
              "client_cancelled",
              "audit_unavailable",
              "upstream_unreachable",
              "upstream_error",
              "invalid_upstream_response",
              "response_too_large",
              "upstream_timeout",
              "tool_output_blocked",
              "content_output_blocked",
              "content_output_unavailable",
              "content_patterns_observed",
              "content_redacted",
              "instruction_patterns_observed",
              "tool_instruction_blocked",
              "tool_instruction_unavailable",
              "instruction_review_applied",
              "invalid_trace_context",
              "trace_unavailable"
            ]
          }
        },
        "output_policy": {
          "$ref": "content.schema.json#/$defs/OutputAssessment",
          "description": "Present when the new sensitive-output policy applies. This supplements the independent credentials-v1 tool check."
        },
        "instruction_policy": {
          "$ref": "#/$defs/InstructionAssessment"
        }
      }
    },
    "InvokeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "text",
        "governance"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 8192,
          "description": "Maximum 8192 UTF-8 bytes at runtime, not 8192 Unicode characters."
        },
        "governance": {
          "allOf": [
            {
              "$ref": "#/$defs/Governance"
            },
            {
              "properties": {
                "authorization": {
                  "const": "allowed"
                },
                "decision": {
                  "enum": [
                    "allow",
                    "observe",
                    "redact"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "InvokeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "governance",
        "error"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "governance": {
          "allOf": [
            {
              "$ref": "#/$defs/Governance"
            },
            {
              "properties": {
                "decision": {
                  "const": "block"
                }
              }
            }
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "type"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "const": "tool_governance_error"
            }
          }
        }
      }
    },
    "ProviderResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 8192,
          "description": "8192 UTF-8 bytes maximum; entire JSON envelope is limited to 64 KiB."
        }
      }
    },
    "InstructionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode"
      ],
      "properties": {
        "version": {
          "enum": [
            "tool-instructions-v1",
            "tool-instructions-v2"
          ]
        },
        "mode": {
          "enum": [
            "observe",
            "block"
          ]
        }
      },
      "description": "Optional operator-owned retrieved instruction-pattern check, pinned by tool revision and explicit detector version. Omitted/null disables it. No semantic safety verdict; quoted attacks also match unless an exact resource review exempts the named rule."
    },
    "InstructionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "state",
        "rule_ids",
        "duration_us",
        "decision"
      ],
      "properties": {
        "version": {
          "enum": [
            "tool-instructions-v1",
            "tool-instructions-v2"
          ]
        },
        "mode": {
          "enum": [
            "observe",
            "block"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "not_observed",
            "unknown"
          ]
        },
        "rule_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "task_override",
              "authority_spoof",
              "role_delimiter",
              "answer_manipulation"
            ]
          }
        },
        "duration_us": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "enum": [
            "allow",
            "observe",
            "block",
            "error"
          ]
        },
        "review": {
          "$ref": "#/$defs/InstructionReviewEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {
                "const": "tool-instructions-v1"
              }
            }
          },
          "then": {
            "properties": {
              "rule_ids": {
                "items": {
                  "enum": [
                    "task_override",
                    "authority_spoof",
                    "role_delimiter"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "InstructionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "detector_version",
        "content_sha256",
        "rule_ids"
      ],
      "properties": {
        "version": {
          "const": "exact-instruction-review-v1"
        },
        "detector_version": {
          "enum": [
            "tool-instructions-v1",
            "tool-instructions-v2"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "task_override",
              "authority_spoof",
              "role_delimiter",
              "answer_manipulation"
            ]
          }
        }
      },
      "description": "Operator permission for the decoded UTF-8 text bytes of this resource only. Detector version must match the tool policy; selected rules must exist in that generation. Does not authorize access, waive credentials/PII, or permit an incomplete scan. Omitted/null clears the review on replacement."
    },
    "InstructionReviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "state",
        "exempted_rule_ids"
      ],
      "properties": {
        "version": {
          "const": "exact-instruction-review-v1"
        },
        "state": {
          "enum": [
            "matched",
            "mismatch",
            "unavailable"
          ]
        },
        "exempted_rule_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "task_override",
              "authority_spoof",
              "role_delimiter",
              "answer_manipulation"
            ]
          }
        }
      },
      "description": "No runtime document hash or excerpt. Original instruction rule_ids/state remain present. A mismatch grants no rule exceptions, but normal content can still pass ordinary checks."
    }
  }
}
