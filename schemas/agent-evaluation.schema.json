    "trajectories": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id",
          "case_id",
          "split",
          "label",
          "mode",
          "status",
          "reason",
          "events",
          "elapsed_ms",
          "usage",
          "audit_complete",
          "attack_success",
          "task_completed",
          "intervention"
        ],
        "properties": {
          "trace_id": {
            "type": "string",
            "pattern": "^trace_[a-f0-9]{32}$"
          },
          "case_id": {
            "type": "string",
            "maxLength": 200
          },
          "split": {
            "enum": [
              "development",
              "evaluation"
            ]
          },
          "label": {
            "enum": [
              "benign",
              "attack"
            ]
          },
          "mode": {
            "enum": [
              "permissive",
              "protected"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "blocked",
              "limited",
              "error"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 13,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "step",
                "round_trip_ms"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "model",
                    "tool"
                  ]
                },
                "step": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "request_id": {
                  "type": "string",
                  "pattern": "^req_[A-Za-z0-9_-]{22}$"
                },
                "http_status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "round_trip_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "output_policy_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_action": {
                  "const": "redacted"
                },
                "tool_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "authorization": {
                  "enum": [
                    "allowed",
                    "denied",
                    "unknown"
                  ]
                },
                "decision": {
                  "enum": [
                    "allow",
                    "observe",
                    "redact",
                    "block"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 200
                },
                "audit": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "operation",
                    "outcome",
                    "duration_ms",
                    "policy_revision"
                  ],
                  "properties": {
                    "operation": {
                      "enum": [
                        "chat.completions",
                        "tools.invoke"
                      ]
                    },
                    "outcome": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "upstream_attempted": {
                      "type": "boolean"
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "policy_revision": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output_policy": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "revision",
                        "result"
                      ],
                      "properties": {
                        "revision": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "result": {
                          "type": "string",
                          "maxLength": 200
                        },
                        "tool_call_version": {
                          "const": "read-tool-call-v1"
                        },
                        "public_email_exceptions": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 32
                        }
                      }
                    },
                    "instruction_policy": {
                      "$ref": "tools.schema.json#/$defs/InstructionAssessment"
                    },
                    "tool_revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "tool_snapshot_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0
          },
          "usage": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "prompt_tokens",
              "completion_tokens",
              "total_tokens"
            ],
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "completion_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "audit_complete": {
            "type": "boolean"
          },
          "attack_success": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "task_completed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "intervention": {
            "type": "boolean"
          }
        }
