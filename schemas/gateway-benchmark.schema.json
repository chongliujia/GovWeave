{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovWeave synthetic gateway load benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "created_at",
    "state",
    "go_version",
    "os",
    "architecture",
    "logical_cpus",
    "benchmark_binary_sha256",
    "build_settings",
    "source_sha256",
    "options",
    "planned_cells",
    "results",
    "comparisons",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark": {
      "const": "gateway-load-v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "running",
        "completed",
        "completed_with_errors",
        "failed"
      ]
    },
    "failure": {
      "enum": [
        "interrupted",
        "cell_execution_failed"
      ]
    },
    "failed_cell": {
      "$ref": "#/$defs/cell"
    },
    "go_version": {
      "type": "string"
    },
    "os": {
      "enum": [
        "darwin",
        "linux"
      ]
    },
    "architecture": {
      "type": "string"
    },
    "logical_cpus": {
      "type": "integer",
      "minimum": 1
    },
    "benchmark_binary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_settings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "planned_cells": {
      "type": "integer",
      "minimum": 4,
      "maximum": 256
    },
    "results": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "comparisons": {
      "type": "array",
      "maxItems": 192,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "concurrency",
        "output_text_bytes",
        "protocol",
        "mode"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "output_text_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "protocol": {
          "enum": [
            "json",
            "sse"
          ]
        },
        "mode": {
          "enum": [
            "direct",
            "disabled",
            "metadata",
            "full"
          ]
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_cell",
        "warmup_per_cell",
        "rounds",
        "concurrency",
        "output_text_bytes",
        "protocols",
        "provider_delay_ms",
        "gateway_gomaxprocs",
        "seed"
      ],
      "properties": {
        "requests_per_cell": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "warmup_per_cell": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "concurrency": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          }
        },
        "output_text_bytes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 128,
            "maximum": 32768
          }
        },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "enum": [
              "json",
              "sse"
            ]
          }
        },
        "provider_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gateway_gomaxprocs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "seed": {
          "type": "integer"
        },
        "profile": {
          "enum": [
            "cpu",
            "contention",
            "trace",
            "allocs"
          ]
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "http_status",
        "elapsed_ms",
        "first_body_byte_ms",
        "response_bytes"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "http_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 599
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "first_body_byte_ms": {
          "type": "number",
          "minimum": 0
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "enum": [
            "request_invalid",
            "transport_error",
            "body_read",
            "http_status",
            "body_mismatch"
          ]
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "min_ms",
        "mean_ms",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "max_ms",
        "p99_is_max_rank"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "min_ms": {
          "type": "number",
          "minimum": 0
        },
        "mean_ms": {
          "type": "number",
          "minimum": 0
        },
        "p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "p99_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_ms": {
          "type": "number",
          "minimum": 0
        },
        "p99_is_max_rank": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ms",
        "process_user_cpu_ms",
        "process_system_cpu_ms",
        "average_process_cpu_cores",
        "peak_rss_bytes_since_process_start",
        "heap_alloc_before_bytes",
        "heap_alloc_after_bytes",
        "heap_sys_before_bytes",
        "heap_sys_after_bytes",
        "allocated_bytes",
        "allocations",
        "gc_cycles",
        "gc_pause_total_ms",
        "estimated_gc_cpu_ms",
        "estimated_gc_assist_cpu_ms"
      ],
      "properties": {
        "window_ms": {
          "type": "number",
          "minimum": 0
        },
        "process_user_cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "process_system_cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "average_process_cpu_cores": {
          "type": "number",
          "minimum": 0
        },
        "peak_rss_bytes_since_process_start": {
          "type": "number",
          "minimum": 0
        },
        "heap_alloc_before_bytes": {
          "type": "number",
          "minimum": 0
        },
        "heap_alloc_after_bytes": {
          "type": "number",
          "minimum": 0
        },
        "heap_sys_before_bytes": {
          "type": "number",
          "minimum": 0
        },
        "heap_sys_after_bytes": {
          "type": "number",
          "minimum": 0
        },
        "allocated_bytes": {
          "type": "number",
          "minimum": 0
        },
        "allocations": {
          "type": "number",
          "minimum": 0
        },
        "gc_cycles": {
          "type": "number",
          "minimum": 0
        },
        "gc_pause_total_ms": {
          "type": "number",
          "minimum": 0
        },
        "estimated_gc_cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "estimated_gc_assist_cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "gc_stopping": {
          "$ref": "#/$defs/pause_histogram"
        },
        "gc_total_pause": {
          "$ref": "#/$defs/pause_histogram"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_calls_including_warmup",
        "started_audit_calls",
        "finished_audit_calls",
        "successful_audits",
        "evidence_files",
        "verified_captures",
        "audit_file_bytes",
        "sealed_evidence_bytes",
        "passed"
      ],
      "properties": {
        "expected_calls_including_warmup": {
          "type": "integer",
          "minimum": 0
        },
        "finished_audit_calls": {
          "type": "integer",
          "minimum": 0
        },
        "successful_audits": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_files": {
          "type": "integer",
          "minimum": 0
        },
        "verified_captures": {
          "type": "integer",
          "minimum": 0
        },
        "audit_file_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sealed_evidence_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        },
        "started_audit_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "concurrency",
        "output_text_bytes",
        "protocol",
        "mode",
        "samples",
        "succeeded",
        "failed",
        "errors",
        "warmup_failed",
        "client_batch_elapsed_ms",
        "client_successes_per_second",
        "all_attempt_latency",
        "success_latency",
        "success_first_body_latency",
        "provider_calls_including_warmup",
        "provider_invalid_requests",
        "provider_count_matches",
        "gateway_resources",
        "durability_verification",
        "gateway_drain_ms",
        "client_start_to_drained_ack_ms",
        "verified_successes_per_durable_second"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "output_text_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "protocol": {
          "enum": [
            "json",
            "sse"
          ]
        },
        "mode": {
          "enum": [
            "direct",
            "disabled",
            "metadata",
            "full"
          ]
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_invalid": {
              "type": "integer",
              "minimum": 0
            },
            "transport_error": {
              "type": "integer",
              "minimum": 0
            },
            "body_read": {
              "type": "integer",
              "minimum": 0
            },
            "http_status": {
              "type": "integer",
              "minimum": 0
            },
            "body_mismatch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "warmup_failed": {
          "type": "integer",
          "minimum": 0
        },
        "client_batch_elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "client_successes_per_second": {
          "type": "number",
          "minimum": 0
        },
        "all_attempt_latency": {
          "anyOf": [
            {
              "$ref": "#/$defs/distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "success_latency": {
          "anyOf": [
            {
              "$ref": "#/$defs/distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "success_first_body_latency": {
          "anyOf": [
            {
              "$ref": "#/$defs/distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_calls_including_warmup": {
          "type": "integer",
          "minimum": 0
        },
        "provider_invalid_requests": {
          "type": "integer",
          "minimum": 0
        },
        "provider_count_matches": {
          "type": "boolean"
        },
        "gateway_resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/resources"
            },
            {
              "type": "null"
            }
          ]
        },
        "durability_verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/verification"
            },
            {
              "type": "null"
            }
          ]
        },
        "gateway_drain_ms": {
          "type": "number",
          "minimum": 0
        },
        "client_start_to_drained_ack_ms": {
          "type": "number",
          "minimum": 0
        },
        "verified_successes_per_durable_second": {
          "type": "number",
          "minimum": 0
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/profile_artifact"
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway_result_index",
        "direct_result_index",
        "comparable",
        "completion_p50_difference_ms",
        "completion_p95_difference_ms",
        "completion_p99_difference_ms",
        "first_body_p95_difference_ms"
      ],
      "properties": {
        "gateway_result_index": {
          "type": "integer",
          "minimum": 0
        },
        "direct_result_index": {
          "type": "integer",
          "minimum": 0
        },
        "comparable": {
          "type": "boolean"
        },
        "completion_p50_difference_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "completion_p95_difference_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "completion_p99_difference_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "first_body_p95_difference_ms": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "profile_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cpu.pprof",
            "block.pprof",
            "mutex.pprof",
            "runtime.trace",
            "allocs-before.pprof",
            "allocs-after.pprof"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^profiles/cell-[0-9]{3}/(cpu\\.pprof|block\\.pprof|mutex\\.pprof|runtime\\.trace|allocs-(before|after)\\.pprof)$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "pause_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_ms",
        "upper_ms",
        "count"
      ],
      "properties": {
        "lower_ms": {
          "type": "number",
          "minimum": 0
        },
        "upper_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pause_histogram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "total_lower_ms",
        "total_upper_ms",
        "buckets"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total_lower_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_upper_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "buckets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pause_bucket"
          }
        }
      }
    }
  }
}
