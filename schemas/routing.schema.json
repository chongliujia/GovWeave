{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen offline canary routing quality and pipeline cost benchmark",
  "description": "Known-marker routing ablation with independently scored authored labels and full-depth-reference agreement. Gated skips remain unknown. Measurements do not establish production realtime performance or legal compliance.",
  "$ref": "#/$defs/Report",
  "$defs": {
    "Policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "risk_type",
            "deep"
          ],
          "properties": {
            "id": {
              "const": "deep_reference"
            },
            "version": {
              "const": "canary-routing-v1"
            },
            "risk_type": {
              "const": "known_marker_exposure"
            },
            "deep": {
              "allOf": [
                {
                  "$ref": "detection.schema.json#/$defs/Ref"
                },
                {
                  "const": {
                    "id": "two_layer",
                    "version": "synthetic-canary-v2"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "risk_type",
            "deep",
            "fast"
          ],
          "properties": {
            "id": {
              "const": "normalized_fallback_all"
            },
            "version": {
              "const": "canary-routing-v1"
            },
            "risk_type": {
              "const": "known_marker_exposure"
            },
            "deep": {
              "allOf": [
                {
                  "$ref": "detection.schema.json#/$defs/Ref"
                },
                {
                  "const": {
                    "id": "two_layer",
                    "version": "synthetic-canary-v2"
                  }
                }
              ]
            },
            "fast": {
              "allOf": [
                {
                  "$ref": "detection.schema.json#/$defs/Ref"
                },
                {
                  "const": {
                    "id": "normalized",
                    "version": "canary-normalized-ablation-v1"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "risk_type",
            "deep",
            "fast",
            "gate_version"
          ],
          "properties": {
            "id": {
              "const": "normalized_encoded_hint"
            },
            "version": {
              "const": "canary-routing-v1"
            },
            "risk_type": {
              "const": "known_marker_exposure"
            },
            "deep": {
              "allOf": [
                {
                  "$ref": "detection.schema.json#/$defs/Ref"
                },
                {
                  "const": {
                    "id": "two_layer",
                    "version": "synthetic-canary-v2"
                  }
                }
              ]
            },
            "fast": {
              "allOf": [
                {
                  "$ref": "detection.schema.json#/$defs/Ref"
                },
                {
                  "const": {
                    "id": "normalized",
                    "version": "canary-normalized-ablation-v1"
                  }
                }
              ]
            },
            "gate_version": {
              "const": "encoded-surface-hints-v1"
            }
          }
        }
      ]
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "gate_version",
        "gate_rules",
        "policies"
      ],
      "properties": {
        "version": {
          "const": "canary-routing-v1"
        },
        "gate_version": {
          "const": "encoded-surface-hints-v1"
        },
        "gate_rules": {
          "const": [
            "escape: %HH, \\uHHHH, \\UHHHH or \\xHH with hexadecimal digits",
            "encoded_run: at least 24 consecutive ASCII characters from [A-Za-z0-9+/_=-]",
            "decimal_sequence: at least eight 2-3 digit integers separated by whitespace or ,;:-",
            "encoding_label: ASCII word base64/base32/base85/rot13/hex/decimal/reverse/reversed/encoded/encoding, case-insensitive",
            "Any hint enables deep evaluation. No hint yields unknown/deep_stage_skipped, never a full-depth negative."
          ]
        },
        "policies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Policy"
                },
                {
                  "properties": {
                    "id": {
                      "const": "deep_reference"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Policy"
                },
                {
                  "properties": {
                    "id": {
                      "const": "normalized_fallback_all"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Policy"
                },
                {
                  "properties": {
                    "id": {
                      "const": "normalized_encoded_hint"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      },
      "description": "The exact v1 routing and surface-hint manifest is frozen before fresh-corpus evaluation. Changes require a new version."
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "risk_type",
        "state",
        "reason",
        "route",
        "gate_reason",
        "deep_evaluated",
        "evidence",
        "steps"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "enum": [
            "deep_reference",
            "normalized_fallback_all",
            "normalized_encoded_hint"
          ]
        },
        "policy_version": {
          "const": "canary-routing-v1"
        },
        "risk_type": {
          "const": "known_marker_exposure"
        },
        "state": {
          "type": "string",
          "enum": [
            "observed",
            "not_observed",
            "unknown"
          ]
        },
        "reason": {
          "$ref": "detection.schema.json#/$defs/Identifier"
        },
        "route": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "deep_reference",
            "fast_unknown",
            "fast_observed",
            "fast_only_unknown",
            "deep_fallback"
          ]
        },
        "gate_reason": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "reference_always",
            "fast_unknown",
            "fast_observed",
            "fallback_all",
            "escape",
            "encoded_run",
            "decimal_sequence",
            "encoding_label",
            "no_encoded_surface_hint"
          ]
        },
        "deep_evaluated": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "detection.schema.json#/$defs/Evidence"
          },
          "maxItems": 8
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "detection.schema.json#/$defs/Observation"
          },
          "maxItems": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deep_evaluated": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "route": {
                "enum": [
                  "deep_reference",
                  "deep_fallback"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "not_evaluated"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "unknown"
              },
              "reason": {
                "const": "not_evaluated"
              },
              "gate_reason": {
                "const": "not_evaluated"
              },
              "deep_evaluated": {
                "const": false
              },
              "steps": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "deep_reference"
              }
            }
          },
          "then": {
            "properties": {
              "policy_id": {
                "const": "deep_reference"
              },
              "gate_reason": {
                "const": "reference_always"
              },
              "steps": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "fast_unknown"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "unknown"
              },
              "gate_reason": {
                "const": "fast_unknown"
              },
              "deep_evaluated": {
                "const": false
              },
              "steps": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "fast_observed"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "observed"
              },
              "gate_reason": {
                "const": "fast_observed"
              },
              "deep_evaluated": {
                "const": false
              },
              "steps": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "fast_only_unknown"
              }
            }
          },
          "then": {
            "properties": {
              "policy_id": {
                "const": "normalized_encoded_hint"
              },
              "state": {
                "const": "unknown"
              },
              "reason": {
                "const": "deep_stage_skipped"
              },
              "gate_reason": {
                "const": "no_encoded_surface_hint"
              },
              "deep_evaluated": {
                "const": false
              },
              "steps": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "deep_fallback"
              }
            }
          },
          "then": {
            "properties": {
              "steps": {
                "minItems": 2,
                "maxItems": 2
              },
              "gate_reason": {
                "enum": [
                  "fallback_all",
                  "escape",
                  "encoded_run",
                  "decimal_sequence",
                  "encoding_label"
                ]
              }
            }
          }
        }
      ]
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "category",
        "expected",
        "response_bytes",
        "eligible",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "group": {
          "type": "string",
          "enum": [
            "validation",
            "challenge",
            "boundary"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expected": {
          "type": "string",
          "enum": [
            "exposed",
            "not_exposed",
            "unevaluable"
          ]
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "eligible": {
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/Result"
        }
      }
    },
    "Comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_policy",
        "state_transitions",
        "reference_observed_lost_ids",
        "reference_observed_lost_exposed_ids",
        "reference_observed_lost_negative_ids",
        "added_false_negative_ids",
        "added_false_positive_ids",
        "added_true_positive_ids",
        "resolved_false_positive_ids",
        "became_unknown_ids",
        "resolved_unknown_ids",
        "unknown_to_not_observed_ids"
      ],
      "properties": {
        "reference_policy": {
          "const": "deep_reference"
        },
        "state_transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_to_observed",
            "observed_to_not_observed",
            "observed_to_unknown",
            "not_observed_to_observed",
            "not_observed_to_not_observed",
            "not_observed_to_unknown",
            "unknown_to_observed",
            "unknown_to_not_observed",
            "unknown_to_unknown"
          ],
          "properties": {
            "observed_to_observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "observed_to_not_observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "observed_to_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "not_observed_to_observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "not_observed_to_not_observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "not_observed_to_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "unknown_to_observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "unknown_to_not_observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "unknown_to_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            }
          }
        },
        "reference_observed_lost_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "reference_observed_lost_exposed_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "reference_observed_lost_negative_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "added_false_negative_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "added_false_positive_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "added_true_positive_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "resolved_false_positive_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "became_unknown_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "resolved_unknown_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "unknown_to_not_observed_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 256,
          "uniqueItems": true
        }
      }
    },
    "Quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "score",
        "groups",
        "cases",
        "fast_requests",
        "deep_requests",
        "fast_evaluations",
        "deep_evaluations",
        "routes"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "score": {
          "$ref": "canary.schema.json#/$defs/Score"
        },
        "groups": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "additionalProperties": false,
          "properties": {
            "validation": {
              "$ref": "canary.schema.json#/$defs/Score"
            },
            "challenge": {
              "$ref": "canary.schema.json#/$defs/Score"
            },
            "boundary": {
              "$ref": "canary.schema.json#/$defs/Score"
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Case"
          },
          "maxItems": 256
        },
        "comparison": {
          "$ref": "#/$defs/Comparison"
        },
        "fast_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "deep_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "fast_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "deep_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "routes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 6,
          "additionalProperties": false,
          "properties": {
            "not_evaluated": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "deep_reference": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "fast_unknown": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "fast_observed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "fast_only_unknown": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "deep_fallback": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          }
        }
      }
    },
    "Counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_calls",
        "registry_requests",
        "fast_requests",
        "deep_requests",
        "fast_evaluations",
        "deep_evaluations"
      ],
      "properties": {
        "pipeline_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "registry_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "fast_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "deep_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "fast_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "deep_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        }
      },
      "description": "Counts distinguish pipeline calls, registry requests and actual entry into plugin code. Completed and discarded measured attempts are tracked separately; quality and warmup calls are excluded."
    },
    "LatencySlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "axis",
        "value",
        "latency"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "enum": [
            "deep_reference",
            "normalized_fallback_all",
            "normalized_encoded_hint"
          ]
        },
        "axis": {
          "type": "string",
          "enum": [
            "all",
            "group",
            "label",
            "category",
            "input_bytes",
            "eligibility",
            "outcome",
            "route",
            "gate_reason",
            "unknown_reason"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "latency": {
          "$ref": "benchmark.schema.json#/$defs/LatencyStats"
        }
      }
    },
    "Round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial",
        "workers",
        "seed",
        "expected_pipeline_calls",
        "pipeline_calls",
        "registry_requests",
        "fast_requests",
        "deep_requests",
        "fast_evaluations",
        "deep_evaluations",
        "discarded_calls",
        "batch_elapsed_ns",
        "complete",
        "slices"
      ],
      "properties": {
        "trial": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "workers": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "seed": {
          "type": "integer"
        },
        "expected_pipeline_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "pipeline_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "registry_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "fast_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "deep_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "fast_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "deep_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "discarded_calls": {
          "$ref": "#/$defs/Counts"
        },
        "batch_elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "slices": {
          "type": "array",
          "minItems": 0,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/LatencySlice"
              },
              {
                "properties": {
                  "axis": {
                    "const": "all"
                  },
                  "value": {
                    "const": "all"
                  }
                }
              }
            ]
          },
          "maxItems": 3
        }
      }
    },
    "Load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "pipeline_calls",
        "registry_requests",
        "fast_requests",
        "deep_requests",
        "fast_evaluations",
        "deep_evaluations",
        "discarded_calls",
        "batch_elapsed_ns",
        "harness_inclusive_pipelines_per_second",
        "slices"
      ],
      "properties": {
        "workers": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "pipeline_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "registry_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "fast_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "deep_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "fast_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "deep_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "discarded_calls": {
          "$ref": "#/$defs/Counts"
        },
        "batch_elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "harness_inclusive_pipelines_per_second": {
          "type": "number",
          "minimum": 0
        },
        "slices": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/LatencySlice"
          },
          "maxItems": 2200
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "benchmark_version",
        "state",
        "measured_at",
        "corpus_id",
        "corpus_version",
        "corpus_sha256",
        "provenance",
        "manifest",
        "manifest_sha256",
        "options",
        "environment",
        "policies",
        "rounds",
        "loads",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "benchmark_version": {
          "const": "canary-routing-cost-quality-v1"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "completed",
            "incomplete"
          ]
        },
        "error_code": {
          "const": "routing_benchmark_cancelled_or_inconsistent"
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "corpus_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "options": {
          "$ref": "benchmark.schema.json#/$defs/Options"
        },
        "environment": {
          "$ref": "benchmark.schema.json#/$defs/Environment"
        },
        "policies": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Quality"
                },
                {
                  "properties": {
                    "policy": {
                      "properties": {
                        "id": {
                          "const": "deep_reference"
                        }
                      }
                    },
                    "cases": {
                      "items": {
                        "properties": {
                          "result": {
                            "properties": {
                              "policy_id": {
                                "const": "deep_reference"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "not": {
                    "required": [
                      "comparison"
                    ]
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Quality"
                },
                {
                  "properties": {
                    "policy": {
                      "properties": {
                        "id": {
                          "const": "normalized_fallback_all"
                        }
                      }
                    },
                    "cases": {
                      "items": {
                        "properties": {
                          "result": {
                            "properties": {
                              "policy_id": {
                                "const": "normalized_fallback_all"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "comparison"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/Quality"
                },
                {
                  "properties": {
                    "policy": {
                      "properties": {
                        "id": {
                          "const": "normalized_encoded_hint"
                        }
                      }
                    },
                    "cases": {
                      "items": {
                        "properties": {
                          "result": {
                            "properties": {
                              "policy_id": {
                                "const": "normalized_encoded_hint"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "comparison"
                  ]
                }
              ]
            }
          ],
          "items": false
        },
        "rounds": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Round"
          },
          "maxItems": 10
        },
        "loads": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Load"
          },
          "maxItems": 2
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "incomplete"
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          }
        }
      ]
    }
  }
}
