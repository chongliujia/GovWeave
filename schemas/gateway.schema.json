{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govweave:gateway:1",
  "$defs": {
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "base_url", "model", "alias", "enabled", "allow_insecure_http", "timeout_seconds"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "base_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "alias": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,99}$"},
        "api_key": {"type": "string", "maxLength": 4096, "description": "Write only. Omit on update to preserve; empty string clears."},
        "enabled": {"type": "boolean"},
        "allow_insecure_http": {"type": "boolean"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "allowed_connections"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "allowed_connections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
