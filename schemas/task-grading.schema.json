{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen task-grading fixture measurements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "grader_version",
    "created_at",
    "corpus_sha256",
    "source_sha256",
    "scores",
    "cases",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "task-grading-validation-v1"
    },
    "grader_version": {
      "const": "task-facts-v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development",
        "validation"
      ],
      "properties": {
        "development": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "agreements",
            "expected_matches",
            "matched",
            "mismatched",
            "unknown",
            "false_accepts",
            "missed_matches"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0
            },
            "agreements": {
              "type": "integer",
              "minimum": 0
            },
            "expected_matches": {
              "type": "integer",
              "minimum": 0
            },
            "matched": {
              "type": "integer",
              "minimum": 0
            },
            "mismatched": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            },
            "false_accepts": {
              "type": "integer",
              "minimum": 0
            },
            "missed_matches": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "agreements",
            "expected_matches",
            "matched",
            "mismatched",
            "unknown",
            "false_accepts",
            "missed_matches"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0
            },
            "agreements": {
              "type": "integer",
              "minimum": 0
            },
            "expected_matches": {
              "type": "integer",
              "minimum": 0
            },
            "matched": {
              "type": "integer",
              "minimum": 0
            },
            "mismatched": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            },
            "false_accepts": {
              "type": "integer",
              "minimum": 0
            },
            "missed_matches": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "split",
          "expected_result",
          "observed_result",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(hours|email)-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "hours",
              "email"
            ]
          },
          "split": {
            "enum": [
              "development",
              "validation"
            ]
          },
          "expected_result": {
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ]
          },
          "observed_result": {
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
